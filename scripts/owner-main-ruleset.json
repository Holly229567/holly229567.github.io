{
  "name": "Only website owner may change main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": 164642264, "actor_type": "User", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": { "include": ["refs/heads/main", "~DEFAULT_BRANCH"], "exclude": [] }
  },
  "rules": [
    { "type": "creation" },
    { "type": "update", "parameters": { "update_allows_fetch_and_merge": false } },
    { "type": "deletion" },
    { "type": "non_fast_forward" }
  ]
}
